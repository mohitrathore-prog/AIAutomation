# Enterprise AI & Automation Opportunity Assessment Platform
# Configuration & Service Adapter Settings

PORT=3000
NODE_ENV=development

# Master Demo Mode Flag (enables mock adapters with seed data when true)
DEMO_MODE=true

# Authentication
JWT_SECRET=corporate-assessment-secret-token-change-in-production
SESSION_EXPIRY_HOURS=24

# AI / LLM Provider Configuration
# Supported providers: mock | openai | azure_openai | anthropic | bedrock | vertex
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4o

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Research & Search Providers
# Supported: mock | tavily | serpapi | brave | custom_scraper
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Storage Provider
# Supported: local | s3 | azure_blob | gcs
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# Corporate Reporting & PDF Generation
# Supported: internal_html | puppeteer | external_service
PDF_GENERATOR=internal_html

# Notification & Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@enterprise-assessment.internal

# Observability & Audit
AUDIT_LOG_ENABLED=true
LOG_LEVEL=info
