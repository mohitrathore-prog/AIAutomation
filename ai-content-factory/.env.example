# ==============================================================================
# AI CONTENT FACTORY ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# Core System Ports
PORT=4000
FRONTEND_PORT=3000
N8N_PORT=5678

# Cryptographic Security
# Used for encrypting/decrypting api tokens in Supabase credentials_settings table.
# Change to a strong random passphrase in production.
ENCRYPTION_SECRET=your_super_secret_cryptographic_passphrase_here

# Supabase Configurations
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# n8n Webhook Secret
N8N_ENCRYPTION_KEY=n8n_secret_random_pass
WEBHOOK_URL=http://localhost:5678/

# ------------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS (Configure securely via Settings Dashboard)
# ------------------------------------------------------------------------------

# LLM Providers
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
DEEPSEEK_API_KEY=sk-ds-...

# Voice Synthesis API Engines
ELEVENLABS_API_KEY=eleven_...
KOKORO_API_ENDPOINT=http://localhost:8888
PIPER_CLI_PATH=/usr/bin/piper

# Image Generators
COMFYUI_ENDPOINT=http://localhost:8188
AUTOMATIC1111_ENDPOINT=http://localhost:7860

# Social Media API Credentials (OAuth tokens)
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_id
LINKEDIN_CLIENT_SECRET=your_linkedin_secret
WORDPRESS_SITE_URL=https://blog.yourdomain.com
WORDPRESS_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx
